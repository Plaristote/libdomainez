#pragma once

// The numeric version format is AAAAABBBBBCCCCCDDDE where:
//
// AAAAA - major version number
// BBBBB - minor version number
// CCCCC - bugfix version number
// DDD   - alpha / beta (DDD + 500) version number
// E     - final (0) / snapshot (1)
//
// When DDDE is not 0, 1 is subtracted from AAAAABBBBBCCCCC. For example:
//
// Version      AAAAABBBBBCCCCCDDDE
//
// 0.1.0        0000000001000000000
// 0.1.2        0000000001000020000
// 1.2.3        0000100002000030000
// 2.2.0-a.1    0000200001999990010
// 3.0.0-b.2    0000299999999995020
// 2.2.0-a.1.z  0000200001999990011
//
#define LIBDOMAINEZ_VERSION       $libdomainez.version.project_number$ULL
#define LIBDOMAINEZ_VERSION_STR   "$libdomainez.version.project$"
#define LIBDOMAINEZ_VERSION_ID    "$libdomainez.version.project_id$"
#define LIBDOMAINEZ_VERSION_FULL  "$libdomainez.version$"

#define LIBDOMAINEZ_VERSION_MAJOR $libdomainez.version.major$
#define LIBDOMAINEZ_VERSION_MINOR $libdomainez.version.minor$
#define LIBDOMAINEZ_VERSION_PATCH $libdomainez.version.patch$

#define LIBDOMAINEZ_PRE_RELEASE   $libdomainez.version.pre_release$

#define LIBDOMAINEZ_SNAPSHOT_SN   $libdomainez.version.snapshot_sn$ULL
#define LIBDOMAINEZ_SNAPSHOT_ID   "$libdomainez.version.snapshot_id$"
