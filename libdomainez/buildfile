intf_libs = # Interface dependencies.
impl_libs = # Implementation dependencies.
import impl_libs += libdatatree%lib{datatree}
import impl_libs += libcurlez%lib{curlez}

lib{domainez}: {hxx ixx txx cxx}{** -version} hxx{version} $impl_libs $intf_libs

hxx{version}: in{version} $src_root/manifest

# Build options.
#
cxx.poptions =+ "-I$out_root" "-I$src_root"

obja{*}: cxx.poptions += -DLIBDOMAINEZ_STATIC_BUILD
objs{*}: cxx.poptions += -DLIBDOMAINEZ_SHARED_BUILD

# Export options.
#
lib{domainez}:
{
  cxx.export.poptions = "-I$out_root" "-I$src_root"
  cxx.export.libs = $intf_libs
}

liba{domainez}: cxx.export.poptions += -DLIBDOMAINEZ_STATIC
libs{domainez}: cxx.export.poptions += -DLIBDOMAINEZ_SHARED

# For pre-releases use the complete version to make sure they cannot
# be used in place of another pre-release or the final version. See
# the version module for details on the version.* variable values.
#
if $version.pre_release
  lib{domainez}: bin.lib.version = "-$version.project_id"
else
  lib{domainez}: bin.lib.version = "-$version.major.$version.minor"

# Install into the libdomainez/ subdirectory of, say, /usr/include/
# recreating subdirectories.
#
{hxx ixx txx}{*}:
{
  install         = include/libdomainez/
  install.subdirs = true
}
